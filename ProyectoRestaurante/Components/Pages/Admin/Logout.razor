@page "/admin/logout"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="logout-bg">
    <div class="logout-container">
        <div class="logout-title">Cerrando sesión</div>
        <div class="logout-msg">Por favor espera un momento...</div>
        <button class="logout-btn" disabled>Redirigiendo</button>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var customProvider = (AutenticacionStateProvider)AuthStateProvider;
        await customProvider.Logout();
        Nav.NavigateTo("/");
    }
}
