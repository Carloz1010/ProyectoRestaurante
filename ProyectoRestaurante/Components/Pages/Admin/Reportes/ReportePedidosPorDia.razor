@page "/admin/reportes/pedidos-por-dia"
@using ProyectoRestaurante.Services.DTOs
@using ProyectoRestaurante.Services.Reporte
@inject IReporteService ReporteService
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<div class="reporte-pedidos-bg">
    <div class="reporte-pedidos-container">
        <h3 class="titulo-reporte-pedidos">Reporte de pedidos por día</h3>
        <div class="reporte-pedidos-form mb-3">
            <label>Fecha:</label>
            <input type="date" @bind="fecha" @bind:format="yyyy-MM-dd" class="form-control" />
        </div>
        <div class="reporte-pedidos-btns">
            <button class="btn btn-primary" @onclick="GenerarReporte">Generar</button>
            <button class="btn btn-secondary" @onclick="Volver">Volver</button>
        </div>
        @if (reporte != null)
        {
            <div class="reporte-pedidos-card">
                <p><strong>Fecha:</strong> @reporte.Fecha.ToShortDateString()</p>
                <p><strong>Total pedidos:</strong> @reporte.TotalPedidos</p>
                <p><strong>Total venta:</strong> @reporte.TotalVenta.ToString("C")</p>
            </div>
        }
        else if (reporte == null && reporteGenerado)
        {
            <div class="reporte-pedidos-alert">
                No se encontraron pedidos para la fecha seleccionada.
            </div>
        }
    </div>
</div>

@code {
    private DateTime fecha = DateTime.Today;
    private ReportePedidosDiaDto? reporte;
    private bool reporteGenerado = false;

    private async Task GenerarReporte()
    {
        try
        {
            reporte = await ReporteService.ReportePedidosPorDia(fecha);
            reporteGenerado = true;

            // En caso de que el total de pedidos sea cero
            if (reporte.TotalPedidos == 0)
            {
                reporte = null;
            }
        }
        catch (Exception ex)
        {
            // Manejo simple de errores
            Console.WriteLine($"Error al generar el reporte: {ex.Message}");
            reporte = null;
            reporteGenerado = true;
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/admin/reportes");
    }
}