@page "/admin/reportes"
<h3>Reportes del sistema</h3>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <h5 class="card-title">Reporte de Ventas</h5>
                <p class="card-text">Consulta el total de ventas y pedidos en un rango de fechas.</p>
                <a class="btn btn-primary mt-auto" href="/admin/reportes/ventas">Ver reporte</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <h5 class="card-title">Ítems Más Vendidos</h5>
                <p class="card-text">Visualiza los productos más vendidos en el periodo seleccionado.</p>
                <a class="btn btn-primary mt-auto" href="/admin/reportes/items-mas-vendidos">Ver reporte</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <h5 class="card-title">Pedidos por Día</h5>
                <p class="card-text">Revisa la cantidad de pedidos realizados por día.</p>
                <a class="btn btn-primary mt-auto" href="/admin/reportes/pedidos-por-dia">Ver reporte</a>
            </div>
        </div>
    </div>
</div>