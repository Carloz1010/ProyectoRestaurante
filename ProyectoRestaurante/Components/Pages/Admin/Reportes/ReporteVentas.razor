@page "/admin/reportes/ventas"
@using ProyectoRestaurante.Services.DTOs
@using ProyectoRestaurante.Services.Reporte
@inject IReporteService ReporteService
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<div class="reporte-ventas-bg">
    <div class="reporte-ventas-container">
        <h3 class="titulo-reporte-ventas">Reporte de ventas</h3>
        <div class="reporte-ventas-form row">
            <div class="col">
                <label>Fecha inicio:</label>
                <input type="date" @bind="inicio" @bind:format="yyyy-MM-dd" class="form-control" />
            </div>
            <div class="col">
                <label>Fecha fin:</label>
                <input type="date" @bind="fin" @bind:format="yyyy-MM-dd" class="form-control" />
            </div>
        </div>
        <div class="reporte-ventas-btns">
            <button class="btn btn-primary" @onclick="GenerarReporte">Generar</button>
            <button class="btn btn-secondary" @onclick="Volver">Volver</button>
        </div>
        @if (reporte != null)
        {
            <div class="reporte-ventas-card">
                <p><strong>Rango:</strong> @reporte.FechaInicio.ToShortDateString() - @reporte.FechaFin.ToShortDateString()</p>
                <p><strong>Número de pedidos:</strong> @reporte.NumeroPedidos</p>
                <p><strong>Total ventas:</strong> @reporte.TotalVentas.ToString("C")</p>
            </div>
        }
    </div>
</div>

@code {
    private DateTime inicio = DateTime.Today.AddDays(-7);
    private DateTime fin = DateTime.Today;

    private ReporteVentasDto? reporte;

    private async Task GenerarReporte()
    {
        try
        {
            reporte = await ReporteService.ReporteVentas(inicio, fin);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al generar reporte: {ex.Message}");
            reporte = null;
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/admin/reportes");
    }
}