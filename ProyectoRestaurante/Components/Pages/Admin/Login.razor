@page "/admin/login"
@using System.ComponentModel.DataAnnotations
@using ProyectoRestaurante.Services.Autenticacion
@using System.Security.Claims
@inject IAutenticacionService AutenticacionService
@inject AutenticacionStateProvider AuthProvider
@inject NavigationManager Nav

<div class="login-container">
    <div class="login-card">

        <h2>Login Administrador</h2>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="error-msg">@error</div>
        }

        <EditForm Model="model" OnValidSubmit="OnLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <!-- Usuario -->
            <div class="form-group">
                <label>Usuario</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-person-fill"></i>
                    </span>
                    <InputText class="form-control" @bind-Value="model.UserName" />
                </div>
            </div>

            <!-- Contraseña -->
            <div class="form-group">
                <label>Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock-fill"></i>
                    </span>
                    <InputText type="password" class="form-control" @bind-Value="model.Contraseña" />
                </div>
            </div>

            <button class="btn-login" type="submit">Ingresar</button>
        </EditForm>

        <div class="login-footer">
            <a href="#">¿Olvidaste tu contraseña?</a>
        </div>

    </div>
</div>

@code {
    private LoginModel model = new();
    private string? error;

    private async Task OnLogin()
    {
        var user = await AutenticacionService.ValidarCredencialesAsync(model.UserName, model.Contraseña);

        if (user is null)
        {
            error = "Usuario o contraseña inválidos";
            return;
        }

        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.Name, user.UserName),
            new Claim(ClaimTypes.Role, "Admin")
        };
        var identity = new ClaimsIdentity(claims, "CustomAuth");
        var principal = new ClaimsPrincipal(identity);

        await AuthProvider.Login(principal);
        Nav.NavigateTo("/admin/ordenes");
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/admin/ordenes");
        }
    }

    public class LoginModel
    {
        [Required] public string UserName { get; set; } = string.Empty;
        [Required] public string Contraseña { get; set; } = string.Empty;
    }
}
