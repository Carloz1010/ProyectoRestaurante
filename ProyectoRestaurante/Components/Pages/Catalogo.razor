@page "/"
@page "/catalogo"
@using ProyectoRestaurante.Services.Carrito
@using ProyectoRestaurante.Services.Catalogo
@using ProyectoRestaurante.Services.DTOs
@inject ICatalogoService CatalogoService
@inject ICarritoService CarritoService
@inject NavigationManager Nav

<div class="fondo-catalogo">
    <h3 class="titulo-seccion">Catálogo</h3>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div>
            @mensaje
        </div>
    }

    @if (productos is null)
    {
        <p>Cargando…</p>
    }
    else if (!productos.Any())
    {
        <p>No hay productos.</p>
    }
    else
    {
        <div class="productos-grid">
            @foreach (var p in productos)
            {
                <div class="producto-card">
                    @if (!string.IsNullOrEmpty(p.ImagenArchivo))
                    {
                        <img src="@($"/img/{p.ImagenArchivo}")"
                             alt="Imagen de @p.Nombre"
                             style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px 8px 0 0;" />
                    }
                    else
                    {
                        <img src="img/placeholder.png"
                             alt="Sin imagen"
                             style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px 8px 0 0;" />
                    }

                    <h4>@p.Nombre</h4>
                    <p>@p.Descripcion</p>
                    <p><b>@p.Precio.ToString("C")</b></p>
                    <div>
                        <button @onclick="() => Agregar(p)">Agregar al carrito</button>
                        <button @onclick="@(() => Nav.NavigateTo($"/producto/{p.Id}"))">Ver</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    List<ProductoDTO>? productos;
    string mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
        => productos = await CatalogoService.ListarProductosAsync(null, null);

    private void Agregar(ProductoDTO p)
    {
        CarritoService.Agregar(p, 1);
        mensaje = $"El producto '{p.Nombre}' fue agregado al carrito.";
        StateHasChanged();
    }
}
