@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthState
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ProyectoRestaurante</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column">
        @if (Autenticado)
        {
            @if (EsAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/ordenes">
                        <span class="bi bi-clipboard-data" aria-hidden="true"></span> Ordenes
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/usuarios">
                        <span class="bi bi-people" aria-hidden="true"></span> Usuarios
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/creacion">
                        <span class="bi bi-people" aria-hidden="true"></span> Crear productos y categorías
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/reportes">
                        <span class="bi bi-people" aria-hidden="true"></span> Reportes
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/logout">
                        <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Cerrar sesión
                    </NavLink>
                </div>
            }
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="catalogo">
                    <span class="bi bi-list-ul" aria-hidden="true"></span> Catálogo
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="carrito">
                    <span class="bi bi-cart-fill-nav-menu" aria-hidden="true"></span> Carrito
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/login">
                    <span class="bi bi-person" aria-hidden="true"></span> Ingresar como administrador
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private ClaimsPrincipal user = new ClaimsPrincipal(new ClaimsIdentity());

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarioInicial();
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private async Task CargarUsuarioInicial()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        user = authState.User;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        user = authState.User;
        await InvokeAsync(StateHasChanged);
    }

    private bool Autenticado => user.Identity?.IsAuthenticated ?? false;

    private bool EsAdmin => user.IsInRole("Admin"); // usando ClaimTypes.Role

    public void Dispose()
    {
        AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
